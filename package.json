{
  "name": "iwmywn",
  "private": true,
  "homepage": "https://iwmywn.github.io",
  "author": "Hoàng Anh Tuấn <itsmethu2408@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "gh-pages": "6.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-minify": "3.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint",
      "oxfmt"
    ],
    "*.{json,css,html,md}": [
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@12.15.0"
}
